---
import { Image } from "astro:assets";
import type { ContentEntry } from "emdash";
import { PortableText } from "emdash/ui";

import Container from "@/components/Container.astro";
import BlueskyIcon from "@/components/icons/BlueskyIcon.astro";
import GitHubIcon from "@/components/icons/GitHubIcon.astro";
import LinkedInIcon from "@/components/icons/LinkedInIcon.astro";
import XIcon from "@/components/icons/XIcon.astro";
import portraitImage from "@/images/avatar.jpg";
import Base from "@/layouts/Base.astro";

import type { Page } from "../../emdash-env";

interface Props {
  title: Page["title"];
  content: Page["content"];
  edit?: ContentEntry<Page>["edit"];
}

const { title, content, edit } = Astro.props;
---

<Base
  title="About"
  description="I'm Josh Kahn. Solutions architect, speaker, technology guy, dad."
>
  <Container class="mt-16 sm:mt-32">
    <div class="grid grid-cols-1 gap-y-16 lg:grid-cols-2 lg:grid-rows-[auto_1fr] lg:gap-y-12">
      <div class="lg:pl-20">
        <div class="max-w-xs px-2.5 lg:max-w-none">
          <Image
            src={portraitImage}
            alt="Josh Kahn"
            sizes="(min-width: 1024px) 32rem, 20rem"
            class="aspect-square rotate-3 rounded-2xl bg-zinc-100 object-cover dark:bg-zinc-800"
          />
        </div>
      </div>
      <div class="lg:order-first lg:row-span-2">
        <h1
          {...edit?.title}
          class="text-4xl font-bold tracking-tight text-zinc-800 sm:text-5xl dark:text-zinc-100"
        >
          {title}
        </h1>
        <div
          {...edit?.content}
          class="mt-6 space-y-7 text-base text-zinc-600 dark:text-zinc-400"
        >
          <PortableText value={content ?? []} />
        </div>
      </div>
      <div class="lg:pl-20">
        <ul role="list">
          <li class="flex">
            <a
              href="https://bsky.app/profile/iamjkahn.com"
              class="group flex text-sm font-medium text-zinc-800 transition hover:text-teal-500 dark:text-zinc-200 dark:hover:text-teal-500"
            >
              <BlueskyIcon class="h-6 w-6 flex-none fill-zinc-500 transition group-hover:fill-teal-500" />
              <span class="ml-4">Follow on Bluesky</span>
            </a>
          </li>
          <li class="mt-4 flex">
            <a
              href="https://github.com/jkahn117"
              class="group flex text-sm font-medium text-zinc-800 transition hover:text-teal-500 dark:text-zinc-200 dark:hover:text-teal-500"
            >
              <GitHubIcon class="h-6 w-6 flex-none fill-zinc-500 transition group-hover:fill-teal-500" />
              <span class="ml-4">Follow on GitHub</span>
            </a>
          </li>
          <li class="mt-4 flex">
            <a
              href="https://www.linkedin.com/in/joshuaakahn/"
              class="group flex text-sm font-medium text-zinc-800 transition hover:text-teal-500 dark:text-zinc-200 dark:hover:text-teal-500"
            >
              <LinkedInIcon class="h-6 w-6 flex-none fill-zinc-500 transition group-hover:fill-teal-500" />
              <span class="ml-4">Follow on LinkedIn</span>
            </a>
          </li>
          <li class="mt-4 flex">
            <a
              href="https://x.com/joshuaakahn"
              class="group flex text-sm font-medium text-zinc-800 transition hover:text-teal-500 dark:text-zinc-200 dark:hover:text-teal-500"
            >
              <XIcon class="h-6 w-6 flex-none fill-zinc-500 transition group-hover:fill-teal-500" />
              <span class="ml-4">Follow on X</span>
            </a>
          </li>
        </ul>
      </div>
    </div>
  </Container>
</Base>
