---
import { getEmDashEntry, type ImageValue } from "emdash";
import { Image } from "emdash/ui";

import Footer from "@/components/Footer.astro";
import { Header } from "@/components/Header.tsx";

import type { Page } from "../../emdash-env";

const homeResult = Astro.isPrerendered
  ? null
  : await getEmDashEntry<"pages", Page & { avatar?: ImageValue }>(
      "pages",
      "home",
    );
if (homeResult?.error && homeResult.error.name !== "LiveEntryNotFoundError") {
  throw homeResult.error;
}
if (homeResult?.isPreview) {
  Astro.cache?.set(false);
  Astro.response.headers.set("Cache-Control", "private, no-store");
  Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow");
  Astro.response.headers.set("Referrer-Policy", "no-referrer");
} else if (homeResult && Astro.cache?.enabled) {
  Astro.cache.set(homeResult.cacheHint);
}
const home = homeResult?.entry;
const avatar =
  home &&
  home.data.slug === "home" &&
  (homeResult?.isPreview || home.data.status === "published")
    ? home.data.avatar
    : undefined;
---

<div class="fixed inset-0 flex justify-center sm:px-8">
  <div class="flex w-full max-w-7xl lg:px-8">
    <div class="w-full bg-white ring-1 ring-zinc-100 dark:bg-zinc-900 dark:ring-zinc-300/20"></div>
  </div>
</div>
<div class="relative flex w-full flex-col">
  <Header
    currentPath={Astro.url.pathname.replace(/\/$/, "") || "/"}
    client:load
  >
    <Image
      slot="avatar"
      image={avatar}
      alt=""
      width={64}
      height={64}
      sizes="64px"
      formats={["webp"]}
      quality={80}
      loading="eager"
      class="h-full w-full rounded-full object-cover"
      style="width: 100%; height: 100%; object-fit: cover;"
    />
  </Header>
  <main class="flex-auto">
    <slot />
  </main>
  <Footer />
</div>
