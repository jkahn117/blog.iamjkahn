---
import { BlueskyPost, type Post } from "@astro-community/astro-embed-bluesky";
import { ONE_HOUR } from "cdn-cache-control";
import { env } from "cloudflare:workers";

import { getAgent } from "../lib/bluesky";
import { withCache } from "../lib/cache";

export const prerender = false;

const { actor, cacheTime = ONE_HOUR } = Astro.props;

// Cache upstream data only. Browsers must revalidate the rendered widget.
Astro.response.headers.set("Cache-Control", "no-cache");

let post: Post | undefined;

const isDev = import.meta.env.DEV;

// New key bypasses entries written with the former seven-day lifetime.
const cacheKey = new Request(
  `https://cache.internal/bluesky/hourly-v1/${actor}`,
);

// Fetch the actor's most recent post from the Bluesky API.
async function getFromBluesky(): Promise<Post | undefined> {
  const agent = await getAgent(
    import.meta.env.PUBLIC_BLUESKY_HANDLE,
    env.BLUESKY_APP_PASSWORD,
  );
  const { data } = await agent.getAuthorFeed({ actor, limit: 1 });
  const fresh = data.feed[0]?.post as Post | undefined;
  console.log(`🦋 Latest post retrieved for ${actor}`);

  return fresh;
}

try {
  post = await withCache(cacheKey, getFromBluesky, {
    isDev,
    cacheTime,
    ctx: Astro.locals.cfContext,
  });
} catch (err) {
  console.error("[🦋 Bluesky component]", err);
}
---

{post && <BlueskyPost post={post} />}
