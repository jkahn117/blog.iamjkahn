---
import { Image } from "emdash/ui";

import Container from "@/components/Container.astro";
import Prose from "@/components/Prose.astro";
import { formatDate } from "@/lib/formatDate.ts";

import type { Post } from "../../emdash-env";

interface Props {
  title: string;
  date: Date;
  featuredImage?: Post["featured_image"];
  terms?: Post["terms"];
}

const { title, date, featuredImage, terms } = Astro.props;
const category = terms?.category?.[0];
const tags = terms?.tag ?? [];
const topics = tags
  .filter((tag) => !tag.slug.startsWith("era-"))
  .toSorted((a, b) => a.label.localeCompare(b.label));
const eras = tags.filter((tag) => tag.slug.startsWith("era-"));
---

<Container class="mt-16 lg:mt-32">
  <div class="xl:relative">
    <div class="mx-auto max-w-2xl">
      <!-- Back button: shown via JS only when navigating from within the site -->
      <button
        id="back-button"
        type="button"
        aria-label="Go back to posts"
        class="group mb-8 hidden h-10 w-10 items-center justify-center rounded-full bg-white shadow-md ring-1 shadow-zinc-800/5 ring-zinc-900/5 transition lg:absolute lg:-left-5 lg:-mt-2 lg:mb-0 xl:-top-1.5 xl:left-0 xl:mt-0 dark:border dark:border-zinc-700/50 dark:bg-zinc-800 dark:ring-0 dark:ring-white/10 dark:hover:border-zinc-700 dark:hover:ring-white/20"
      >
        <svg
          viewBox="0 0 16 16"
          fill="none"
          aria-hidden="true"
          class="h-4 w-4 stroke-zinc-500 transition group-hover:stroke-zinc-700 dark:stroke-zinc-500 dark:group-hover:stroke-zinc-400"
        >
          <path
            d="M7.25 11.25 3.75 8m0 0 3.5-3.25M3.75 8h8.5"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          ></path>
        </svg>
      </button>
      <script is:inline>
        (function () {
          var btn = document.getElementById("back-button");
          if (
            btn &&
            document.referrer &&
            document.referrer.includes(location.hostname)
          ) {
            btn.classList.remove("hidden");
            btn.classList.add("flex");
            btn.addEventListener("click", function () {
              history.back();
            });
          }
        })();
      </script>

      <article class="post-content">
        <header class="flex flex-col">
          <h1 class="mt-6 text-4xl font-bold tracking-tight text-zinc-800 sm:text-5xl dark:text-zinc-100">
            {title}
          </h1>
          <div class="order-first flex flex-wrap items-center gap-x-3 gap-y-2 text-base">
            <time
              datetime={date.toISOString()}
              class="text-zinc-400 dark:text-zinc-500"
            >
              {formatDate(date)}
            </time>
            {category && (
              <span class="inline-flex items-center gap-3">
                <span
                  aria-hidden="true"
                  class="h-4 w-0.5 shrink-0 rounded-full bg-zinc-400 dark:bg-zinc-500"
                />
                <span class="text-zinc-400 dark:text-zinc-500">
                  <span class="sr-only">Category: </span>
                  {category.label}
                </span>
              </span>
            )}
          </div>
        </header>
        {featuredImage && (
          <Image
            image={featuredImage}
            class="mt-8 h-auto w-full rounded-3xl"
            sizes="(min-width: 800px) 672px, (min-width: 640px) calc(100vw - 128px), calc(100vw - 32px)"
            priority
          />
        )}
        <Prose class="mt-8">
          <slot />
        </Prose>
        {(topics.length > 0 || eras.length > 0) && (
          <footer class="mt-10 border-t border-zinc-100 pt-6 dark:border-zinc-800">
            {topics.length > 0 && (
              <ul aria-label="Topics" class="flex flex-wrap gap-2">
                {topics.map((tag) => (
                  <li class="rounded-full border border-zinc-200 px-2.5 py-0.5 text-xs font-medium text-zinc-600 dark:border-zinc-700 dark:text-zinc-300">
                    {tag.label}
                  </li>
                ))}
              </ul>
            )}
            {eras.length > 0 && (
              <div class:list={[{ "mt-4": topics.length > 0 }]}>
                <p class="text-sm text-zinc-500 dark:text-zinc-400">
                  From the archives tour: the{" "}
                  {eras.map((era) => era.label).join(", ")} era.
                </p>
                <p class="mt-1 text-xs text-zinc-400 dark:text-zinc-500">
                  An era groups posts by when I wrote them, not what they're
                  about.
                </p>
              </div>
            )}
          </footer>
        )}
      </article>
    </div>
  </div>
</Container>

<style>
  .post-content :global([id^="fn-"]) {
    display: grid;
    grid-template-columns: 1.5em minmax(0, 1fr);
    column-gap: 0.5em;
    font-size: 0.875em;
    line-height: 1.6;
    scroll-margin-top: 2rem;
  }

  .post-content :global([id^="fn-"] > sup:first-child) {
    grid-column: 1;
    grid-row: 1;
    position: static;
    font-size: inherit;
    line-height: inherit;
  }

  .post-content :global([id^="fn-"] > :not(sup)) {
    grid-column: 2;
    margin-block: 0 0.75em;
  }

  .post-content :global([id^="fn-"] > :last-child) {
    margin-bottom: 0;
  }
</style>
