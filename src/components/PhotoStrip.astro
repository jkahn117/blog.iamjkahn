---
import { Image } from "astro:assets";
import { Image as EmDashImage } from "emdash/ui";

import image1 from "@/images/photos/image-1.jpg";
import image2 from "@/images/photos/image-2.jpg";
import image3 from "@/images/photos/image-3.jpg";
import image4 from "@/images/photos/image-4.jpg";
import image5 from "@/images/photos/image-5.jpg";

import type { PageLayoutPhotoStripBlock } from "../../emdash-env";

interface Props {
  value?: PageLayoutPhotoStripBlock;
}

const { value } = Astro.props;
// An absent CMS layout uses the originals during rollout. An empty block stays empty.
const photos = value
  ? (value.photos ?? []).map(({ image, alt }) => ({
      image,
      alt,
      local: undefined,
    }))
  : [image1, image2, image3, image4, image5].map((local) => ({
      local,
      image: undefined,
      alt: "",
    }));
const rotations = [
  "rotate-2",
  "-rotate-2",
  "rotate-2",
  "rotate-2",
  "-rotate-2",
];
---

{photos.length > 0 && (
  <div class="mt-16 sm:mt-20" data-photo-strip={value ? "cms" : "fallback"}>
    <div class="-my-4 flex justify-center gap-5 overflow-hidden py-4 sm:gap-8">
      {photos.map((photo, i) => (
        <div
          class:list={[
            "relative aspect-9/10 w-44 flex-none overflow-hidden rounded-xl bg-zinc-100 sm:w-72 sm:rounded-2xl dark:bg-zinc-800",
            rotations[i % rotations.length],
          ]}
        >
          {photo.local ? (
            <Image
              src={photo.local}
              alt=""
              sizes="(min-width: 640px) 18rem, 11rem"
              loading="lazy"
              decoding="async"
              class="absolute inset-0 h-full w-full object-cover"
            />
          ) : (
            <EmDashImage
              image={photo.image}
              alt={photo.alt ?? photo.image?.alt ?? ""}
              width={288}
              height={320}
              sizes="(min-width: 640px) 18rem, 11rem"
              formats={["webp"]}
              quality={80}
              loading="lazy"
              decoding="async"
              class="absolute inset-0 h-full w-full object-cover"
            />
          )}
        </div>
      ))}
    </div>
  </div>
)}
