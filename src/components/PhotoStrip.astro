---
import { Image as EmDashImage } from "emdash/ui";

import type { PageLayoutPhotoStripBlock } from "../../emdash-env";

interface Props {
  value?: PageLayoutPhotoStripBlock;
}

const { value } = Astro.props;
const photos = value?.photos ?? [];
const rotations = [
  "rotate-2",
  "-rotate-2",
  "rotate-2",
  "rotate-2",
  "-rotate-2",
];
---

{photos.length > 0 && (
  <div class="mt-16 sm:mt-20" data-photo-strip="cms">
    <div class="-my-4 flex justify-center gap-5 overflow-hidden py-4 sm:gap-8">
      {photos.map((photo, i) => (
        <div
          class:list={[
            "relative aspect-9/10 w-44 flex-none overflow-hidden rounded-xl bg-zinc-100 sm:w-72 sm:rounded-2xl dark:bg-zinc-800",
            rotations[i % rotations.length],
          ]}
        >
          <EmDashImage
            image={photo.image}
            alt={photo.alt ?? photo.image?.alt ?? ""}
            width={288}
            height={320}
            sizes="(min-width: 640px) 18rem, 11rem"
            formats={["webp"]}
            quality={80}
            loading="lazy"
            decoding="async"
            class="absolute inset-0 h-full w-full object-cover"
            style="width: 100%; height: 100%; object-fit: cover;"
          />
        </div>
      ))}
    </div>
  </div>
)}
