---
import {
  getContentSeo,
  getSeoMeta,
  getSiteSettingsWithCacheHint,
} from "emdash";
import type { ContentEntry, SiteSettings } from "emdash";

import Layout from "@/components/Layout.astro";

import "@/css/tailwind.css";
import { safeHttpUrl } from "@/lib/site-settings";

interface Props {
  title?: string;
  description?: string;
  ogType?: "website" | "article";
  publishedDate?: string;
  author?: string;
  image?: string;
  seoEntry?: ContentEntry<{ title: string }>;
  siteSettings?: SiteSettings;
}

const {
  title,
  description,
  ogType = "website",
  publishedDate,
  author,
  image,
  seoEntry,
  siteSettings,
} = Astro.props;

const settingsResult =
  Astro.isPrerendered || siteSettings
    ? null
    : await getSiteSettingsWithCacheHint();
const settings = siteSettings ?? settingsResult?.data;
if (settingsResult && Astro.cache?.enabled)
  Astro.cache.set(settingsResult.cacheHint);

const siteUrl = import.meta.env.PUBLIC_SITE_URL ?? "https://blog.iamjkahn.com";
const analyticsUrl = import.meta.env.PUBLIC_ANALYTICS_URL;
const siteTitle = settings?.title;
const titleSeparator = settings?.seo?.titleSeparator ?? " - ";
const defaultOgImage =
  safeHttpUrl(image, siteUrl) ??
  safeHttpUrl(settings?.seo?.defaultOgImage?.url, siteUrl);
const defaultTitle =
  title ?? [siteTitle, settings?.tagline].filter(Boolean).join(titleSeparator);
const canonicalPathname =
  Astro.url.pathname !== "/" && Astro.url.pathname.endsWith("/")
    ? Astro.url.pathname.slice(0, -1)
    : Astro.url.pathname;
const editorTitle = seoEntry && getContentSeo(seoEntry)?.title;
const seo = getSeoMeta(seoEntry ?? { data: {} }, {
  // The default homepage title already starts with the site name.
  siteTitle: title || editorTitle ? siteTitle : undefined,
  siteUrl,
  titleSeparator,
  path: canonicalPathname,
  defaultOgImage,
  defaultTitle,
  defaultDescription: description ?? settings?.tagline,
});
const faviconUrl = Astro.isPrerendered
  ? "/favicon.svg"
  : safeHttpUrl(settings?.favicon?.url, siteUrl);
---

<html lang="en" class="h-full antialiased">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{seo.title}</title>
    {seo.description && <meta name="description" content={seo.description} />}

    <!-- Open Graph -->
    <meta property="og:title" content={seo.title} />
    {seo.ogDescription && (
      <meta property="og:description" content={seo.ogDescription} />
    )}
    <meta property="og:url" content={seo.canonical} />
    {siteTitle && <meta property="og:site_name" content={siteTitle} />}
    <meta property="og:type" content={ogType} />
    {seo.ogImage && <meta property="og:image" content={seo.ogImage} />}
    {ogType === "article" && publishedDate && (
      <meta property="article:published_time" content={publishedDate} />
    )}
    {ogType === "article" && author && (
      <meta property="article:author" content={author} />
    )}

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={seo.title} />
    {seo.ogDescription && (
      <meta name="twitter:description" content={seo.ogDescription} />
    )}
    {seo.ogImage && <meta name="twitter:image" content={seo.ogImage} />}

    <link rel="canonical" href={seo.canonical} />
    {seo.robots && <meta name="robots" content={seo.robots} />}
    {faviconUrl && (
      <link
        rel="icon"
        href={faviconUrl}
        type={
          Astro.isPrerendered ? "image/svg+xml" : settings?.favicon?.contentType
        }
      />
    )}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={siteTitle}
      href={`${siteUrl}/feed.xml`}
    />

    {analyticsUrl && (
      <script
        id="counterscale-script"
        data-site-id="blog.iamjkahn"
        src={analyticsUrl}
        defer
      />
    )}

    <!-- Apply the theme before first paint, then follow system changes. -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var system = window.matchMedia("(prefers-color-scheme: dark)");
        var stored;
        try {
          stored = localStorage.getItem("theme");
        } catch {
          // Storage may be unavailable. Follow the system for this visit.
        }
        root.dataset.theme =
          stored === "light" || stored === "dark" ? stored : "system";

        function applyTheme() {
          var preference = root.dataset.theme;
          var dark =
            preference === "dark" ||
            (preference === "system" && system.matches);
          root.classList.toggle("dark", dark);
          root.style.colorScheme = dark ? "dark" : "light";
        }

        applyTheme();
        system.addEventListener("change", applyTheme);
        document.addEventListener("theme-change", applyTheme);
      })();
    </script>
  </head>
  <body class="flex h-full bg-zinc-50 dark:bg-black">
    <div class="flex w-full">
      <Layout>
        <slot />
      </Layout>
    </div>
  </body>
</html>
