---
export const prerender = false;

import { getEmDashCollection, getEmDashEntry, getRequestContext } from "emdash";
import { PortableText } from "emdash/ui";

import PostLayout from "@/components/PostLayout.astro";
import Base from "@/layouts/Base.astro";
import { getPostDate, getPostPath } from "@/lib/posts";

const { year, month, slug } = Astro.params;
if (!year || !month || !slug) return new Response("Not found", { status: 404 });

// Historical URLs belong to the imported entry, not its editable current slug.
const { entries, error: routeError } = await getEmDashCollection("posts", {
  status: "published",
  where: { legacy_route: `${year}/${month}/${slug}` },
  limit: 1,
});
if (routeError) throw routeError;
const preview = getRequestContext()?.preview;
const id =
  preview?.collection === "posts" ? preview.id : (entries[0]?.data.id ?? slug);

const {
  entry: post,
  error,
  isPreview,
  cacheHint,
} = await getEmDashEntry("posts", id);
if (error && error.name !== "LiveEntryNotFoundError") throw error;
if (
  !post ||
  (!isPreview && post.data.status !== "published") ||
  post.data.redirect_link ||
  getPostPath(post.data) !== `/posts/${year}/${month}/${slug}`
) {
  // The site's /404 page is prerendered, so an on-demand route cannot rewrite to it.
  return new Response("Not found", { status: 404 });
}

if (isPreview) {
  Astro.response.headers.set("Cache-Control", "private, no-store");
  Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow");
} else if (Astro.cache?.enabled) {
  Astro.cache.set(cacheHint);
}

const date = getPostDate(post.data);
---

<Base
  title={post.data.title}
  description={post.data.excerpt}
  ogType="article"
  publishedDate={date.toISOString()}
  author={post.data.byline?.displayName}
>
  <PostLayout title={post.data.title} date={date}>
    <PortableText value={post.data.content ?? []} />
  </PostLayout>
</Base>
