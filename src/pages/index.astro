---
export const prerender = false;

import { BookOpenIcon, BriefcaseIcon } from "@heroicons/react/24/outline";
import { getEmDashEntry } from "emdash";
import { Blocks, defineBlockComponents } from "emdash/ui";

import Bluesky from "@/components/Bluesky.astro";
import Card from "@/components/Card/Card.astro";
import CardCta from "@/components/Card/CardCta.astro";
import CardDescription from "@/components/Card/CardDescription.astro";
import CardEyebrow from "@/components/Card/CardEyebrow.astro";
import CardTitle from "@/components/Card/CardTitle.astro";
import Container from "@/components/Container.astro";
import Goodreads from "@/components/Goodreads.astro";
import BlueskyIcon from "@/components/icons/BlueskyIcon.astro";
import GitHubIcon from "@/components/icons/GitHubIcon.astro";
import LinkedInIcon from "@/components/icons/LinkedInIcon.astro";
import XIcon from "@/components/icons/XIcon.astro";
import PhotoStrip from "@/components/PhotoStrip.astro";
import Widget from "@/components/Widget/Widget.astro";
import WidgetTitle from "@/components/Widget/WidgetTitle.astro";
import logoAccenture from "@/images/logos/accenture.svg";
import logoAmazon from "@/images/logos/amazon.svg";
import logoApple from "@/images/logos/apple.svg";
import logoCloudflare from "@/images/logos/cloudflare.svg";
import logoStripe from "@/images/logos/stripe.svg";
import Base from "@/layouts/Base.astro";
import { formatDate } from "@/lib/formatDate.ts";
import { getPublicPosts } from "@/lib/posts";

import type { PageLayoutBlock } from "../../emdash-env";

const { posts: allPosts, cacheHint } = await getPublicPosts();
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
const posts = allPosts.slice(0, 4);

const resume = [
  {
    company: "Cloudflare",
    title: "Principal Solutions Architect",
    logo: logoCloudflare,
    start: "2025",
    end: "Present",
  },
  {
    company: "Stripe",
    title: "Solutions Architect",
    logo: logoStripe,
    start: "2025",
    end: "2025",
  },
  {
    company: "Amazon Web Services",
    title: "Principal Solutions Architect",
    logo: logoAmazon,
    start: "2016",
    end: "2025",
  },
  {
    company: "Apple",
    title: "iAd Technology Evangelist",
    logo: logoApple,
    start: "2013",
    end: "2016",
  },
  {
    company: "Accenture",
    title: "Senior Manager",
    logo: logoAccenture,
    start: "2004",
    end: "2013",
  },
];

const homeResult = await getEmDashEntry("pages", "home");
if (homeResult.error && homeResult.error.name !== "LiveEntryNotFoundError") {
  throw homeResult.error;
}
const home =
  homeResult.entry?.data.slug === "home" &&
  (homeResult.isPreview || homeResult.entry.data.status === "published")
    ? homeResult.entry
    : null;
if (homeResult.isPreview) {
  Astro.response.headers.set("Cache-Control", "private, no-store");
  Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow");
  Astro.response.headers.set("Referrer-Policy", "no-referrer");
} else if (Astro.cache?.enabled) {
  Astro.cache.set(homeResult.cacheHint);
}
const blockComponents = defineBlockComponents<PageLayoutBlock>({
  photo_strip: PhotoStrip,
});
---

<Base>
  <Container class="mt-9">
    <div class="max-w-2xl">
      <h1 class="text-4xl font-bold tracking-tight text-zinc-800 sm:text-5xl dark:text-zinc-100">
        Solutions architect, speaker, technology guy, dad
      </h1>
      <p class="mt-6 text-base text-zinc-600 dark:text-zinc-400">
        I&apos;m Josh, a solutions architect, speaker, house IT guy, and dad. My
        site is some part blog, some part collection of what I&apos;ve done over
        the last twenty plus years.
      </p>
      <div class="mt-6 flex gap-6">
        <a
          href="https://bsky.app/profile/iamjkahn.com"
          aria-label="Follow on Bluesky"
          class="group -m-1 p-1"
        >
          <BlueskyIcon class="h-6 w-6 fill-zinc-500 transition group-hover:fill-zinc-600 dark:fill-zinc-400 dark:group-hover:fill-zinc-300" />
        </a>
        <a
          href="https://github.com/jkahn117"
          aria-label="Follow on GitHub"
          class="group -m-1 p-1"
        >
          <GitHubIcon class="h-6 w-6 fill-zinc-500 transition group-hover:fill-zinc-600 dark:fill-zinc-400 dark:group-hover:fill-zinc-300" />
        </a>
        <a
          href="https://www.linkedin.com/in/joshuaakahn/"
          aria-label="Follow on LinkedIn"
          class="group -m-1 p-1"
        >
          <LinkedInIcon class="h-6 w-6 fill-zinc-500 transition group-hover:fill-zinc-600 dark:fill-zinc-400 dark:group-hover:fill-zinc-300" />
        </a>
        <a
          href="https://x.com/joshuaakahn"
          aria-label="Follow on X"
          class="group -m-1 p-1"
        >
          <XIcon class="h-6 w-6 fill-zinc-500 transition group-hover:fill-zinc-600 dark:fill-zinc-400 dark:group-hover:fill-zinc-300" />
        </a>
      </div>
    </div>
  </Container>

  {home?.data.layout ? (
    <Blocks value={home.data.layout} components={blockComponents} />
  ) : (
    <PhotoStrip />
  )}

  <Container class="mt-24 md:mt-28">
    <div class="mx-auto grid max-w-xl grid-cols-1 gap-y-20 lg:max-w-none lg:grid-cols-2">
      <!-- Recent posts -->
      <div class="flex flex-col gap-16">
        {posts.map((post) => (
          <Card as="article">
            <CardTitle href={post.href}>{post.title}</CardTitle>
            <CardEyebrow as="time" datetime={post.date.toISOString()} decorate>
              {formatDate(post.date)}
            </CardEyebrow>
            <CardDescription>{post.excerpt}</CardDescription>
            <CardCta>Read post</CardCta>
          </Card>
        ))}
      </div>

      <!-- Resume -->
      <div class="space-y-10 lg:pl-16 xl:pl-24">
        <Widget>
          <WidgetTitle icon={BriefcaseIcon}>Work</WidgetTitle>
          <ol class="space-y-4">
            {resume.map((role) => (
              <li class="flex gap-4">
                <div class="relative mt-1 flex h-10 w-10 flex-none items-center justify-center rounded-full shadow-md ring-1 shadow-zinc-800/5 ring-zinc-900/5 dark:border dark:border-zinc-700/50 dark:bg-zinc-800 dark:ring-0">
                  <img src={role.logo.src} alt="" class="h-7 w-7" />
                </div>
                <dl class="flex flex-auto flex-wrap gap-x-2">
                  <dt class="sr-only">Company</dt>
                  <dd class="w-full flex-none text-sm font-medium text-zinc-900 dark:text-zinc-100">
                    {role.company}
                  </dd>
                  <dt class="sr-only">Role</dt>
                  <dd class="text-xs text-zinc-500 dark:text-zinc-400">
                    {role.title}
                  </dd>
                  <dt class="sr-only">Date</dt>
                  <dd class="ml-auto text-xs text-zinc-400 dark:text-zinc-500">
                    {role.start} — {role.end}
                  </dd>
                </dl>
              </li>
            ))}
          </ol>
        </Widget>

        <Widget>
          <WidgetTitle icon={BlueskyIcon}>Latest Post</WidgetTitle>
          <Bluesky actor={import.meta.env.PUBLIC_BLUESKY_HANDLE} server:defer />
        </Widget>

        <Widget>
          <WidgetTitle icon={BookOpenIcon}>What I'm Reading</WidgetTitle>
          <Goodreads userId="102451238-josh-k" server:defer />
        </Widget>
      </div>
    </div>
  </Container>
</Base>
