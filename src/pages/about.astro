---
export const prerender = false;

import { getEmDashEntry } from "emdash";

import AboutProfile from "@/components/AboutProfile.astro";
import NotFound from "@/components/NotFound.astro";

const { entry, isPreview, cacheHint, error } = await getEmDashEntry(
  "pages",
  "about",
);
if (error && error.name !== "LiveEntryNotFoundError") throw error;
const page =
  entry?.data.slug === "about" &&
  (isPreview || entry.data.status === "published")
    ? entry
    : null;
if (!page) Astro.response.status = 404;
if (!page || isPreview) {
  Astro.response.headers.set("Cache-Control", "private, no-store");
  Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow");
  Astro.response.headers.set("Referrer-Policy", "no-referrer");
} else if (Astro.cache?.enabled) {
  Astro.cache.set(cacheHint);
}
---

{page ? <AboutProfile entry={page} /> : <NotFound />}
